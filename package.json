{
  "name": "codex-quota-monitor",
  "version": "1.0.0",
  "description": "Windows desktop monitor for live Codex quota usage",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js",
    "pack": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lizihao.liquidquota",
    "productName": "Codex 额度实时监控",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "watcher.ps1",
      "scripts/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
